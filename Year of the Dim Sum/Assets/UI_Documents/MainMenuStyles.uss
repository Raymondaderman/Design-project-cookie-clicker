:root {
}

.mainMenuButton {
    width: 318px;
    height: 80px;
    font-size: 60px;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
    -unity-font-definition: url("project://database/Assets/Font/DarumadropOne-Regular.ttf?fileID=12800000&guid=d11475950ce383347a70b1041c77d5d3&type=3#DarumadropOne-Regular");
    background-image: url("project://database/Assets/Art/UI/UI_Knap%20.png?fileID=2800000&guid=4a0f73a9de662574ab8eddf64372af86&type=3#UI_Knap ");
    color: rgb(215, 194, 97);
    position: absolute;
    -unity-text-align: upper-center;
    white-space: nowrap;
    background-color: rgb(255, 255, 255);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

.mainMenuButton:hover {
    width: 318px;
    height: 80px;
    font-size: 74px;
    translate: 0 0;
    scale: 1.1 1.1;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    -unity-text-align: upper-center;
    white-space: nowrap;
    position: absolute;
}

.mainMenuButton:active {
    width: 318px;
    height: 80px;
    font-size: 74px;
    translate: 0 0;
    scale: 0.9 0.9;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
    -unity-text-align: upper-center;
    white-space: nowrap;
    position: absolute;
}
